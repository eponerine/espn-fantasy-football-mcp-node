# Base URL of the espn-fantasy-football-api-node HTTP API.
FF_API_BASE_URL=http://localhost:3000

# Default league scope. Tools can override these per call.
LEAGUE_ID=123456
SEASON_YEAR=2026

# Private-league ESPN cookies.
# PREFERRED: set these on the API server instead and leave them blank here,
# so the MCP process never has to put credentials on a query string.
ESPN_S2=
SWID=

# Optional tuning.
FF_API_TIMEOUT_MS=20000
FF_CACHE_TTL_MS=60000
